# Fitwell Environment Configuration

# Exposed Host Ports (configured to avoid conflicts with other projects like Datalift)
POSTGRES_HOST_PORT=5433
FRONTEND_PORT=3001
BACKEND_PORT=8080

# Internal Database Settings
DB_NAME=fitwell
DB_USER=fitwell_user
DB_PASSWORD=fitwell_secret

# For local development outside Docker
DB_HOST=localhost
DB_PORT=5433
PORT=8080
UPLOAD_DIR=./uploads

# AI Provider Configuration (Optional - fallback rule-based if unset)
AI_PROVIDER=mock # or gemini, openai
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Seed and Dev settings
ENABLE_DEV_SEED=true
DEV_AUTO_VERIFY_EMAIL=true # Set to true to automatically mark registration emails verified in dev
ADMIN_DEFAULT_EMAIL=admin@fitwell.ma
ADMIN_DEFAULT_PASSWORD=AdminSecure2026!
